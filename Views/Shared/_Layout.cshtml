@using Microsoft.AspNetCore.Identity
@using Diplom_CRM.Models
@inject UserManager<AppUser> UserManager
@{
    var currentUser = await UserManager.GetUserAsync(User);
    bool isAdmin = currentUser != null && await UserManager.IsInRoleAsync(currentUser, "Admin");
    var displayName = currentUser != null
        ? $"{currentUser.FirstName} {currentUser.LastName}"
        : User?.Identity?.Name ?? "Гость";
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – Diplom CRM</title>
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
        :root {
            --sidebar-collapsed-width: 70px;
            --sidebar-expanded-width: 250px;
        }

        body {
            min-height: 100vh;
        }

        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            width: var(--sidebar-collapsed-width);
            background-color: #212529;
            padding-top: 20px;
            overflow-x: hidden;
            transition: width 0.3s ease;
            z-index: 1030;
            box-shadow: 2px 0 10px rgba(0, 0, 0, 0.3);
        }

        .navbar-top {
            margin-left: var(--sidebar-collapsed-width);
        }

        .main-content{
            margin-left: var(--sidebar-collapsed-width);
            padding-top: 15px;
        }

        .navbar-top {
            position: sticky;
            top: 0;
            z-index: 1020;
        }

        .sidebar .nav-link {
            display: flex;
            align-items: center;
            white-space: nowrap;
            padding: 0.75rem 1rem;
        }

        .sidebar .link-text {
            display: none;
            margin-left: 10px;
            opacity: 0;
            transition: opacity 0.2s ease 0.1s;
        }

        .sidebar:hover {
            width: var(--sidebar-expanded-width);
        }

        .sidebar:hover .link-text {
            display: inline;
            opacity: 1;
        }

        .htmx-indicator {
            display: none;
        }
        .htmx-request .htmx-indicator,
        .htmx-request.htmx-indicator {
            display: inline-block;
        }
    </style>
    @RenderSection("Styles", required: false)
</head>
<body>
    <nav class="navbar navbar-light bg-light border-bottom navbar-top">
        <div class="container-fluid">
            <span class="navbar-brand mb-0 h1">CRM Панель</span>
            <div class="d-flex align-items-center">
                <span class="me-3">@displayName</span>
                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                    <button type="submit" class="btn btn-outline-secondary btn-sm">Выйти</button>
                </form>
            </div>
        </div>
    </nav>

    <aside class="sidebar d-flex flex-column text-white">
        <ul class="nav nav-pills flex-column mb-auto px-2">
            <li class="nav-item">
                <a class="nav-link text-white @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active bg-primary" : "")"
                   href="/Dashboard/Index">
                    <i class="bi bi-speedometer2 fs-5"></i>
                    <span class="link-text">Дашборд</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-white @(ViewContext.RouteData.Values["controller"]?.ToString() == "Company" ? "active bg-primary" : "")"
                   href="/Company/Index">
                    <i class="bi bi-building fs-5"></i>
                    <span class="link-text">Клиенты</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-white @(ViewContext.RouteData.Values["controller"]?.ToString() == "Deal" ? "active bg-primary" : "")"
                   href="/Deal/Index">
                    <i class="bi bi-kanban fs-5"></i>
                    <span class="link-text">Воронка сделок</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-white @(ViewContext.RouteData.Values["controller"]?.ToString() == "Activity" ? "active bg-primary" : "")"
                   href="/Activity/Index">
                    <i class="bi bi-list-check fs-5"></i>
                    <span class="link-text">Задачи</span>
                </a>
            </li>
            @if (isAdmin)
            {
                <li class="nav-item">
                    <a class="nav-link text-white @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" && ViewContext.RouteData.Values["action"]?.ToString() == "Users" ? "active bg-primary" : "")"
                       href="/Admin/Users">
                        <i class="bi bi-people-fill fs-5"></i>
                        <span class="link-text">Пользователи</span>
                    </a>
                </li>
            }
        </ul>
    </aside>

    <main class="main-content">
        @RenderBody()
    </main>

    <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1100;">
        <div id="appToast" class="toast align-items-center text-white border-0" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body" id="appToastMessage">
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/htmx/htmx.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        function formatLocalTime(utcString) {
            const date = new Date(utcString);
            if (isNaN(date.getTime())) return utcString;
            return date.toLocaleString('ru-RU', {
                day: '2-digit',
                month: '2-digit',
                year: 'numeric',
                hour: '2-digit',
                minute: '2-digit'
            });
        }

        function updateLocalTimes() {
            document.querySelectorAll('.local-time').forEach(el => {
                const utc = el.getAttribute('data-utc');
                if (utc) {
                    el.textContent = formatLocalTime(utc);
                }
            });
        }

        document.addEventListener('DOMContentLoaded', updateLocalTimes);
        document.body.addEventListener('htmx:afterSwap', updateLocalTimes);
    </script>

    <script>
            document.body.addEventListener('htmx:configRequest', (evt) => {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                if (token) {
                    evt.detail.headers['RequestVerificationToken'] = token;
                }
            });
    </script>

    <script>
            document.body.addEventListener('showToast', function(evt) {
                const rawMessage = evt.detail.message || '';
                const type = evt.detail.type || 'info'; // 'success', 'error', 'warning', 'info'

                const message = decodeURIComponent(rawMessage);

                const toastEl = document.getElementById('appToast');
                const toastMessageEl = document.getElementById('appToastMessage');

                if (!toastEl || !toastMessageEl) return;

                toastEl.classList.remove('bg-success', 'bg-danger', 'bg-warning', 'bg-info', 'bg-dark');

                switch (type.toLowerCase()) {
                    case 'success':
                        toastEl.classList.add('bg-success');
                        break;
                    case 'error':
                        toastEl.classList.add('bg-danger');
                        break;
                    case 'warning':
                        toastEl.classList.add('bg-warning', 'text-dark');
                        break;
                    default:
                        toastEl.classList.add('bg-info');
                        break;
                }

                toastMessageEl.textContent = message;
                const bsToast = bootstrap.Toast.getOrCreateInstance(toastEl, { delay: 4000 });
                bsToast.show();
            });
    </script>

    <script>
            function resetActivityForm(form) {
                form.reset();

                const taskBlock = document.getElementById('taskCompletionBlock');
                const completedDateGroup = document.getElementById('completedDateGroup');

                if (taskBlock) taskBlock.style.display = 'none';
                if (completedDateGroup) completedDateGroup.style.display = 'none';
            }

            document.addEventListener('change', function(e) {
                if (e.target && e.target.name === 'Type') {
                    const taskBlock = document.getElementById('taskCompletionBlock');
                    if (taskBlock) {
                        taskBlock.style.display = (e.target.value === 'Task') ? 'block' : 'none';
                    }
                }

                if (e.target && e.target.id === 'taskIsCompleted') {
                    const completedDateGroup = document.getElementById('completedDateGroup');
                    if (completedDateGroup) {
                        completedDateGroup.style.display = e.target.checked ? 'block' : 'none';
                    }
                }
            });
    </script>
    @Html.AntiForgeryToken()
</body>
</html>