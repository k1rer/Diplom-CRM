@using Microsoft.AspNetCore.Identity
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – Diplom CRM</title>
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
        :root {
            --sidebar-collapsed-width: 70px;
            --sidebar-expanded-width: 250px;
        }

        body {
            min-height: 100vh;
        }

        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            width: var(--sidebar-collapsed-width);
            background-color: #212529;
            padding-top: 20px;
            overflow-x: hidden;
            transition: width 0.3s ease;
            z-index: 1030;
            box-shadow: 2px 0 10px rgba(0, 0, 0, 0.3);
        }

        .main-content,
        .navbar-top {
            margin-left: var(--sidebar-collapsed-width);
        }

        .navbar-top {
            position: sticky;
            top: 0;
            z-index: 1020;
        }

        .sidebar .nav-link {
            display: flex;
            align-items: center;
            white-space: nowrap;
            padding: 0.75rem 1rem;
        }

        .sidebar .link-text {
            display: none;
            margin-left: 10px;
            opacity: 0;
            transition: opacity 0.2s ease 0.1s;
        }

        /* Развёрнутое состояние только для самой панели */
        .sidebar:hover {
            width: var(--sidebar-expanded-width);
        }

        .sidebar:hover .link-text {
            display: inline;
            opacity: 1;
        }

        /* Индикатор htmx */
        .htmx-indicator {
            display: none;
        }
        .htmx-request .htmx-indicator,
        .htmx-request.htmx-indicator {
            display: inline-block;
        }
    </style>
    @RenderSection("Styles", required: false)
</head>
<body>
    <!-- Верхняя панель -->
    @inject UserManager<AppUser> UserManager
    @{
        var currentUser = await UserManager.GetUserAsync(User);
        var displayName = currentUser != null
            ? $"{currentUser.FirstName} {currentUser.LastName}"
            : User?.Identity?.Name ?? "Гость";
    }
    <nav class="navbar navbar-light bg-light border-bottom navbar-top">
        <div class="container-fluid">
            <span class="navbar-brand mb-0 h1">CRM Панель</span>
            <div class="d-flex align-items-center">
                <span class="me-3">@displayName</span>
                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                    <button type="submit" class="btn btn-outline-secondary btn-sm">Выйти</button>
                </form>
            </div>
        </div>
    </nav>

    <!-- Боковое меню (сайдбар) -->
    <aside class="sidebar d-flex flex-column text-white">
        <ul class="nav nav-pills flex-column mb-auto px-2">
            <li class="nav-item">
                <a class="nav-link text-white @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active bg-primary" : "")"
                   href="/Dashboard/Index">
                    <i class="bi bi-speedometer2 fs-5"></i>
                    <span class="link-text">Дашборд</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-white @(ViewContext.RouteData.Values["controller"]?.ToString() == "Company" ? "active bg-primary" : "")"
                   href="/Company/Index">
                    <i class="bi bi-building fs-5"></i>
                    <span class="link-text">Клиенты</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-white @(ViewContext.RouteData.Values["controller"]?.ToString() == "Deal" ? "active bg-primary" : "")"
                   href="/Deal/Index">
                    <i class="bi bi-kanban fs-5"></i>
                    <span class="link-text">Воронка сделок</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-white @(ViewContext.RouteData.Values["controller"]?.ToString() == "Activity" ? "active bg-primary" : "")"
                   href="/Activity/Index">
                    <i class="bi bi-list-check fs-5"></i>
                    <span class="link-text">Задачи</span>
                </a>
            </li>
        </ul>
    </aside>

    <!-- Основной контент -->
    <main class="main-content">
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/htmx/htmx.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <!-- Глобальные скрипты -->
    <script>
        // Преобразование UTC-дат в локальное время
        function formatLocalTime(utcString) {
            const date = new Date(utcString);
            if (isNaN(date.getTime())) return utcString;
            return date.toLocaleString('ru-RU', {
                day: '2-digit',
                month: '2-digit',
                year: 'numeric',
                hour: '2-digit',
                minute: '2-digit'
            });
        }

        function updateLocalTimes() {
            document.querySelectorAll('.local-time').forEach(el => {
                const utc = el.getAttribute('data-utc');
                if (utc) {
                    el.textContent = formatLocalTime(utc);
                }
            });
        }

        document.addEventListener('DOMContentLoaded', updateLocalTimes);
        document.body.addEventListener('htmx:afterSwap', updateLocalTimes);
    </script>
</body>
</html>