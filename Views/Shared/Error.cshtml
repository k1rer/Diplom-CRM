@model Diplom_CRM.Models.View.ErrorViewModel
@{
    ViewData["Title"] = "Ошибка";
}

<div class="container mt-5">
    <div class="alert alert-danger">
        <h4 class="alert-heading">Произошла ошибка</h4>
        <p>При обработке запроса возникла проблема. Пожалуйста, попробуйте позже или обратитесь к администратору.</p>
        @if (Model.ShowRequestId)
        {
            <hr />
            <p class="mb-0"><strong>ID запроса:</strong> <code>@Model.RequestId</code></p>
        }
    </div>
    <a href="/" class="btn btn-outline-primary">На главную</a>
</div>