@model Diplom_CRM.Models.View.CompanyDetailsViewModel
@using Diplom_CRM.Models.DTO
@{
    ViewData["Title"] = $"Клиент: {Model.Company?.Name}";
    var company = Model.Company;
    var contacts = Model.Contacts ?? new List<ContactDTO>();
    var activities = Model.Activities ?? new List<ActivityDTO>();
}

<div class="container-fluid">
    <h2 class="mb-4">@company?.Name</h2>

    <div class="row">
        <div class="col-md-4">
            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="card-title">@company?.Name</h5>
                    <dl class="row mb-0">
                        <dt class="col-sm-5">Отрасль</dt>
                        <dd class="col-sm-7">@(company?.Industry ?? "—")</dd>

                        <dt class="col-sm-5">Сайт</dt>
                        <dd class="col-sm-7">
                            @if (!string.IsNullOrWhiteSpace(company?.Website))
                            {
                                <a href="@company.Website" target="_blank">@company.Website</a>
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </dd>

                        <dt class="col-sm-5">Телефон</dt>
                        <dd class="col-sm-7">@(company?.Phone ?? "—")</dd>

                        <dt class="col-sm-5">Адрес</dt>
                        <dd class="col-sm-7">@(company?.Address ?? "—")</dd>

                        <dt class="col-sm-5">Город</dt>
                        <dd class="col-sm-7">@(company?.City ?? "—")</dd>

                        <dt class="col-sm-5">Страна</dt>
                        <dd class="col-sm-7">@(company?.Country ?? "—")</dd>
                    </dl>
                </div>
            </div>

            <div class="card" id="contactsListContainer">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span class="fw-bold">Контакты компании</span>
                    <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#addContactModal">
                        + Добавить
                    </button>
                </div>
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush">
                        @foreach (var contact in contacts)
                        {
                            <li class="list-group-item">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <strong>@contact.FirstName @contact.LastName</strong>
                                        <small class="text-muted d-block">@(contact.Position ?? "Без должности")</small>
                                    </div>
                                    <div class="text-end">
                                        <a href="tel:@contact.Phone" class="d-block text-decoration-none">@contact.Phone</a>
                                        @if (!string.IsNullOrWhiteSpace(contact.Email))
                                        {
                                            <a href="mailto:@contact.Email" class="small">@contact.Email</a>
                                        }
                                    </div>
                                </div>
                            </li>
                        }
                        @if (!contacts.Any())
                        {
                            <li class="list-group-item text-muted">Нет добавленных контактов</li>
                        }
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card mb-4">
            <div class="card-header">
                <span class="fw-bold">Добавить активность</span>
            </div>
            <div class="card-body">
                @if (Model.Contacts == null || !Model.Contacts.Any())
                {
                    <div class="alert alert-warning">
                        Сначала добавьте контактное лицо, чтобы создавать активности.
                    </div>
                }
                else
                {
                        <div class="card shadow-sm mb-4">
                            <div class="card-body p-2">
                                @if (Model.Contacts == null || !Model.Contacts.Any())
                                {
                                    <div class="text-muted p-2">Добавьте контакт, чтобы создавать активности</div>
                                }
                                else
                                {
                                    <form hx-post="/Activity/Create"
                                          hx-target="#timelineContainer"
                                          hx-swap="innerHTML"
                                          hx-on::after-request="this.reset()"
                                          hx-indicator="#activityIndicator">

                                        <input type="hidden" name="CompanyId" value="@Model.Company?.Id" />
                                        <input type="hidden" name="ContactId" value="@Model.Contacts.First().Id" />

                                        <textarea class="form-control border-0 bg-light" rows="2" name="Description"
                                                  placeholder="Напишите заметку, результат звонка или задачу..."></textarea>

                                        <div class="d-flex justify-content-between align-items-center mt-2">

                                            <div class="btn-group btn-group-sm" role="group" aria-label="Тип активности">
                                                <input type="radio" class="btn-check" name="Type" id="type-call" value="Call" autocomplete="off" checked>
                                                <label class="btn btn-outline-secondary" for="type-call" title="Звонок">
                                                    <i class="bi bi-telephone-fill"></i>
                                                </label>

                                                <input type="radio" class="btn-check" name="Type" id="type-email" value="Email" autocomplete="off">
                                                <label class="btn btn-outline-secondary" for="type-email" title="Email">
                                                    <i class="bi bi-envelope-fill"></i>
                                                </label>

                                                <input type="radio" class="btn-check" name="Type" id="type-meeting" value="Meeting" autocomplete="off">
                                                <label class="btn btn-outline-secondary" for="type-meeting" title="Встреча">
                                                    <i class="bi bi-people-fill"></i>
                                                </label>

                                                <input type="radio" class="btn-check" name="Type" id="type-task" value="Task" autocomplete="off">
                                                <label class="btn btn-outline-secondary" for="type-task" title="Задача">
                                                    <i class="bi bi-check2-square"></i>
                                                </label>
                                            </div>

                                            <button type="submit" class="btn btn-primary btn-sm">
                                                <span class="htmx-indicator" id="activityIndicator">
                                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                                </span>
                                                <i class="bi bi-send"></i> Отправить
                                            </button>
                                        </div>
                                    </form>
                                }
                            </div>
                        </div>
                }
            </div>
        </div>

            <div id="timelineContainer">
                @await Html.PartialAsync("_TimelinePartial", activities)
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="addContactModal" tabindex="-1" aria-labelledby="addContactModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addContactModalLabel">Новый контакт</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
            </div>
            <form hx-post="/Company/AddContact"
                  hx-target="#contactsListContainer"
                  hx-swap="innerHTML">
                <input type="hidden" name="companyId" value="@Model.Company?.Id" />
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Имя *</label>
                        <input type="text" class="form-control" name="FirstName" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Фамилия</label>
                        <input type="text" class="form-control" name="LastName" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Должность</label>
                        <input type="text" class="form-control" name="Position" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Телефон</label>
                        <input type="text" class="form-control" name="Phone" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input type="email" class="form-control" name="Email" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Сохранить</button>
                </div>
            </form>
        </div>
    </div>
</div>