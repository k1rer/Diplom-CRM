@model Diplom_CRM.Models.View.CompanyDetailsViewModel
@using Diplom_CRM.Models.DTO
@{
    ViewData["Title"] = $"Клиент: {Model.Company?.Name}";
    var company = Model.Company;
    var contacts = Model.Contacts ?? new List<ContactDTO>();
    var activities = Model.Activities ?? new List<ActivityDTO>();
}

<div class="container-fluid">
    <h2 class="mb-4">@company?.Name</h2>

    <div class="row">
        <div class="col-md-4">
            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="card-title d-flex justify-content-between align-items-center">
                        @company?.Name
                        <button class="btn btn-outline-success btn-sm"
                                hx-get="/Deal/Create?companyId=@(company?.Id ?? 0)"
                                hx-target="#dealModalBody"
                                hx-swap="innerHTML"
                                data-bs-toggle="modal"
                                data-bs-target="#dealModal">
                            <i class="bi bi-briefcase-fill"></i> Открыть сделку
                        </button>
                    </h5>
                    <dl class="row mb-0">
                        <dt class="col-sm-5">Отрасль</dt>
                        <dd class="col-sm-7">@(company?.Industry ?? "—")</dd>

                        <dt class="col-sm-5">Сайт</dt>
                        <dd class="col-sm-7">
                            @if (!string.IsNullOrWhiteSpace(company?.Website))
                            {
                                <a href="@company.Website" target="_blank">@company.Website</a>
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </dd>

                        <dt class="col-sm-5">Телефон</dt>
                        <dd class="col-sm-7">
                            @if (!string.IsNullOrWhiteSpace(company?.Phone))
                            {
                                <i class="bi bi-telephone-fill me-1"></i>
                                @company.Phone
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </dd>

                        <dt class="col-sm-5">Адрес</dt>
                        <dd class="col-sm-7">@(company?.Address ?? "—")</dd>

                        <dt class="col-sm-5">Город</dt>
                        <dd class="col-sm-7">@(company?.City ?? "—")</dd>

                        <dt class="col-sm-5">Страна</dt>
                        <dd class="col-sm-7">@(company?.Country ?? "—")</dd>
                    </dl>
                </div>
            </div>

            @await Html.PartialAsync("_ContactListPartial", contacts)
        </div>

        <div class="col-md-8">
            <div class="card mb-4">
                <div class="card-header p-2">
                    <button class="btn btn-link text-decoration-none p-0 collapsed"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#collapseNewActivity"
                            aria-expanded="false"
                            aria-controls="collapseNewActivity">
                        <i class="bi bi-plus-circle me-1"></i> Новая активность
                    </button>
                </div>
                <div class="collapse" id="collapseNewActivity">
                    <div class="card-body p-2">
                        @if (contacts == null || !contacts.Any())
                        {
                            <div class="alert alert-warning mb-0">
                                Сначала добавьте контактное лицо, чтобы создавать активности.
                            </div>
                        }
                        else
                        {
                            @await Html.PartialAsync("_CreateActivity")
                        }
                    </div>
                </div>
            </div>

            <div id="timelineContainer"
                 hx-get="/Company/GetTimeline?companyId=@(company?.Id ?? 0)"
                 hx-trigger="refreshTimeline from:body"
                 hx-swap="innerHTML">
                @await Html.PartialAsync("_TimelinePartial", activities)
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="addContactModal" tabindex="-1" aria-labelledby="addContactModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addContactModalLabel">Новый контакт</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
            </div>
            <form hx-post="/Company/AddContact" hx-target="#contactsListContainer" hx-swap="innerHTML">
                <input type="hidden" name="companyId" value="@(company?.Id ?? 0)" />
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Имя *</label>
                        <input type="text" class="form-control" name="FirstName" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Фамилия</label>
                        <input type="text" class="form-control" name="LastName" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Должность</label>
                        <input type="text" class="form-control" name="Position" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Телефон</label>
                        <input type="text" class="form-control" name="Phone" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input type="email" class="form-control" name="Email" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Сохранить</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="editContactModal" tabindex="-1" aria-labelledby="editContactModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editContactModalLabel">Редактировать контакт</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
            </div>
            <div class="modal-body" id="editContactModalBody">
                <!-- Содержимое загрузится через htmx -->
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteContactModal" tabindex="-1" aria-labelledby="deleteContactModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteContactModalLabel">Подтверждение удаления</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
            </div>
            <div class="modal-body" id="deleteContactModalBody">
                <!-- Содержимое загрузится через htmx -->
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="dealModal" tabindex="-1" aria-labelledby="dealModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="dealModalLabel">Новая сделка</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
            </div>
            <div class="modal-body" id="dealModalBody">
                <!-- Содержимое загрузится через htmx -->
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.body.addEventListener('closeEditModal', function() {
            var modal = bootstrap.Modal.getInstance(document.getElementById('editContactModal'));
            if (modal) modal.hide();
        });

        document.body.addEventListener('closeDealModal', function() {
            var modal = bootstrap.Modal.getInstance(document.getElementById('dealModal'));
            if (modal) modal.hide();
        });

        document.querySelectorAll('input[name="Type"]').forEach(radio => {
            radio.addEventListener('change', function() {
                const isTask = this.value === 'Task';
                const scheduledLabel = document.querySelector('.scheduled-label');
                const scheduledInput = document.getElementById('activityScheduledDate');
                const taskBlock = document.getElementById('taskCompletionBlock');
                const completedCheckbox = document.getElementById('taskIsCompleted');
                const completedDateGroup = document.getElementById('completedDateGroup');

                if (isTask) {
                    scheduledLabel.textContent = 'Срок выполнения задачи';
                    scheduledInput.required = true;
                    taskBlock.style.display = '';
                } else {
                    scheduledLabel.textContent = 'Дата и время';
                    scheduledInput.required = false;
                    taskBlock.style.display = 'none';
                    completedCheckbox.checked = false;
                    completedDateGroup.style.display = 'none';
                }
            });
        });

        const taskIsCompleted = document.getElementById('taskIsCompleted');
        if (taskIsCompleted) {
            taskIsCompleted.addEventListener('change', function() {
                document.getElementById('completedDateGroup').style.display = this.checked ? '' : 'none';
            });
        }
    </script>
}