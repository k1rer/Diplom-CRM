@model List<Diplom_CRM.Models.DTO.ActivityListItemDTO>
@{
    var today = DateTime.Today;
}

<div id="pending-tasks" hx-swap="outerHTML">
    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-success">
            <i class="bi bi-check-circle"></i> Нет просроченных задач
        </div>
    }
    else
    {
        <div class="list-group">
            @foreach (var task in Model)
            {
                <div class="list-group-item d-flex justify-content-between align-items-center @(task.ScheduledDate.Date < today ? "list-group-item-danger" : "list-group-item-warning")">
                    <div>
                        <strong>@task.Subject</strong>
                        <div class="small text-muted">
                            @task.ContactName
                            @if (!string.IsNullOrEmpty(task.DealName))
                            {
                                <span> • @task.DealName</span>
                            }
                        </div>
                        <small>@task.ScheduledDate.ToString("dd.MM.yyyy")</small>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox"
                               hx-post="/Activity/CompleteTask?activityId=@task.Id"
                               hx-target="#pending-tasks"
                               hx-swap="outerHTML"
                        @(task.IsCompleted ? "checked disabled" : "") />
                        <label class="form-check-label">Готово</label>
                    </div>
                </div>
            }
        </div>
    }
</div>