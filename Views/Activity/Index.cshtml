@model IEnumerable<Diplom_CRM.Models.DTO.ActivityDTO>
@{
    ViewData["Title"] = "Активности";
}
<div class="container-fluid">
    <h2 class="mb-4">Фильтр активностей</h2>
    <div class="row">
        <div class="col-md-3">
            <form id="advancedFilterForm"
                  hx-get="/Activity/Index"
                  hx-target="#activityListContainer"
                  hx-trigger="change, input delay:300ms from:input[type='text']">
                <div class="card shadow-sm mb-3">
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label">Поиск</label>
                            <input type="text" name="search" class="form-control" placeholder="Тема или описание..." />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Тип</label>
                            <select name="type" class="form-select">
                                <option value="">Все</option>
                                <option value="Call">Звонки</option>
                                <option value="Email">Письма</option>
                                <option value="Meeting">Встречи</option>
                                <option value="Task">Задачи</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Статус задачи</label>
                            <select name="status" class="form-select">
                                <option value="All">Все</option>
                                <option value="Pending">В процессе</option>
                                <option value="Completed">Завершено</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Клиент / Компания</label>
                            <select name="companyId" class="form-select" asp-items="ViewBag.Companies">
                                <option value="">Все</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Сделка</label>
                            <select name="dealId" class="form-select" asp-items="ViewBag.Deals">
                                <option value="">Все</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Менеджер</label>
                            <select name="userId" class="form-select" asp-items="ViewBag.Users">
                                <option value="">Все</option>
                            </select>
                        </div>
                        <div class="row g-2">
                            <div class="col-6">
                                <label class="form-label">С даты</label>
                                <input type="date" name="fromDate" class="form-control" />
                            </div>
                            <div class="col-6">
                                <label class="form-label">По дату</label>
                                <input type="date" name="toDate" class="form-control" />
                            </div>
                        </div>
                        <div class="mt-3">
                            <label class="form-label">Сортировка</label>
                            <select name="sortBy" class="form-select">
                                <option value="date_desc">Сначала новые</option>
                                <option value="date_asc">Сначала старые</option>
                            </select>
                        </div>
                        <button type="reset" class="btn btn-outline-secondary mt-3 w-100">
                            Сбросить
                        </button>
                    </div>
                </div>
            </form>
        </div>
        <div class="col-md-9">
            <div id="activityListContainer">
                @await Html.PartialAsync("_ActivityListPartial", Model)
            </div>
        </div>
    </div>
</div>