@model IEnumerable<Diplom_CRM.Models.DTO.ActivityDTO>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">Активности не найдены.</div>
}
else
{
    <div class="row g-3" id="activityFeedRow">
        @foreach (var activity in Model)
        {
            <div class="activity-card-wrapper col-12">
                @await Html.PartialAsync("_ActivityCardPartial", activity)
            </div>
        }
    </div>
}