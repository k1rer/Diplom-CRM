@using Diplom_CRM.Data.Enums
@using Diplom_CRM.Extensions
@model Diplom_CRM.Models.DTO.ActivityDTO
@{
    var badgeClass = Model.Type switch
    {
        TypeEnum.Call => "bg-primary",
        TypeEnum.Email => "bg-success",
        TypeEnum.Meeting => "bg-info text-dark",
        TypeEnum.Task => "bg-warning text-dark",
        _ => "bg-secondary"
    };
    var typeName = Model.Type.GetDisplayName();
    var isTask = Model.Type == TypeEnum.Task;
    var completed = Model.IsCompleted;
}

<div class="card mb-3 shadow-sm" id="activity-@Model.Id">
    <div class="card-body p-3">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="badge @badgeClass">@typeName</span>
            <small class="text-muted">@Model.ScheduledDate.ToString("g")</small>
        </div>
        <div class="mb-2">
            <small class="text-muted">
                @if (!string.IsNullOrWhiteSpace(Model.CompanyName))
                {
                    <span>Компания: @Model.CompanyName</span>
                }
                @if (!string.IsNullOrWhiteSpace(Model.DealName))
                {
                    <span> / Сделка: @Model.DealName</span>
                }
            </small>
        </div>
        <h6>@Model.Subject</h6>
        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <p class="mb-1">@Model.Description</p>
        }


        @if (isTask && completed && Model.CompletedDate.HasValue)
        {
            <div class="small text-muted mt-1">
                <i class="bi bi-check-circle me-1"></i> Завершено:
                <span class="local-time" data-utc="@Model.CompletedDate.Value.ToUniversalTime().ToString("o")">
                    @Model.CompletedDate.Value.ToLocalTime().ToString("g")
                </span>
            </div>
        }

        <div class="d-flex justify-content-between align-items-center mt-2">
            @if (isTask)
            {
                <form hx-post="/Activity/ToggleTaskCard"
                      hx-target="#activity-@Model.Id"
                      hx-swap="outerHTML"
                      class="d-inline">
                    <input type="hidden" name="activityId" value="@Model.Id" />
                    <button type="submit"
                            class="btn btn-sm @(completed ? "btn-outline-secondary" : "btn-success")">
                        @if (completed)
                        {
                            <i class="bi bi-arrow-counterclockwise me-1"></i>
                            <text>Снять</text>
                        }
                        else
                        {
                            <i class="bi bi-check-lg me-1"></i>
                            <text>Выполнено</text>
                        }
                    </button>
                </form>
            }
            <button class="btn btn-sm btn-outline-danger ms-auto"
                    hx-delete="/Activity/DeleteActivity?activityId=@Model.Id"
                    hx-include="#advancedFilterForm"
                    hx-target="#activityListContainer"
                    hx-swap="innerHTML"
                    title="Удалить">
                <i class="bi bi-trash"></i>
            </button>
        </div>
    </div>
</div>