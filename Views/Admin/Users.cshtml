@model List<Diplom_CRM.Models.DTO.UserDTO>
@{
    ViewData["Title"] = "Управление пользователями";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Пользователи системы</h2>
        <button class="btn btn-primary"
                hx-get="/Admin/CreateUser"
                hx-target="#createUserModal .modal-body"
                hx-swap="innerHTML"
                data-bs-toggle="modal"
                data-bs-target="#createUserModal">
            <i class="bi bi-person-plus"></i> Добавить пользователя
        </button>
    </div>

    <div id="usersTableContainer"
         hx-get="/Admin/Users"
         hx-trigger="refreshUsersList from:body"
         hx-swap="innerHTML">
        <!-- таблица пользователей из Partials -->
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Имя</th>
                    <th>Email</th>
                    <th>Роль</th>
                    <th>Сделок в работе</th>
                    <th>Статус</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    @await Html.PartialAsync("_UserRowPartial", user)
                }
            </tbody>
        </table>
    </div>
    <!-- Модальное окно создания пользователя -->
    <div class="modal fade" id="createUserModal" tabindex="-1" aria-labelledby="createUserModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="createUserModalLabel">Новый пользователь</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
                </div>
                <div class="modal-body">
                    <!-- Форма загружается сюда -->
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        document.body.addEventListener('closeCreateUserModal', function() {
            var modalEl = document.getElementById('createUserModal');
            var modal = bootstrap.Modal.getInstance(modalEl);
            if (modal) modal.hide();
        });
    </script>
}