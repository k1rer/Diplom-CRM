@model List<Diplom_CRM.Models.DTO.UserDTO>

<table class="table table-hover align-middle">
    <thead class="table-light">
        <tr>
            <th>Имя</th>
            <th>Email</th>
            <th>Роль</th>
            <th>Сделок в работе</th>
            <th>Статус</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            @await Html.PartialAsync("_UserRowPartial", user)
        }
    </tbody>
</table>