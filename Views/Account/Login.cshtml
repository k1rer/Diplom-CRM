@model Diplom_CRM.Models.View.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Вход в CRM";
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
            body {
                background-color: #f5f7fa;
            }

            .login-card {
                max-width: 400px;
                width: 100%;
            }
    </style>
</head>
<body class="d-flex align-items-center justify-content-center vh-100">
    <div class="login-card">
        <div class="card shadow-lg">
            <div class="card-header bg-primary text-white text-center">
                <h4 class="mb-0">CRM Панель</h4>
            </div>
            <div class="card-body p-4">
                <h5 class="card-title mb-4">Вход в систему</h5>
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" class="form-control" placeholder="name@example.com" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-lock"></i></span>
                            <input asp-for="Password" class="form-control" placeholder="Пароль" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <div class="mb-3 form-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label"></label>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Войти</button>
                </form>
            </div>
            <div class="card-footer text-center">
                @if (Model.AllowRegistration)
                {
                    <span>Нет аккаунта?</span> <a asp-action="Register" class="text-decoration-none">Зарегистрироваться</a>
                }
                else
                {
                    <span class="text-muted">Регистрация закрыта</span>
                }
            </div>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>